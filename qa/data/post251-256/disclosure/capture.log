. * Pure native targeted receipt; ROOT must cold-load the complete authenticated
. * 4eecca4d09d61df0cfe773fc2024b015920b5fe6 (tabtools 2.5.6) source before this do.
. * No net install, ado-path mutation, fixture promotion, or R execution here.
. version 17.0

. set more off

. set varabbrev off

. args artifact_dir

. if `"`artifact_dir'"' == "" exit 198

. 
. program define _post251_capture
  1.     syntax , OUTDIR(string) ID(string) VARS(string) [slashN CATROWPERC MISSINGSUMMARY TOTAL(string) MODE(string)]
  2.     quietly save `"`outdir'/`id'-input.dta"', replace
  3.     local sc "3"
  4.     if "`mode'" == "primary" local sc "3, primary"
  5.     local totalopt ""
  6.     if "`total'" != "" local totalopt "total(`total')"
  7.     capture noisily table1_tc, by(g) vars(`vars') smallcells(`sc') nopvalue ///
>         `slashN' `catrowperc' `missingsummary' `totalopt' frame(_post251_result, replace) ///
>         csv(`"`outdir'/`id'.csv"') markdown(`"`outdir'/`id'.md"') ///
>         excel(`"`outdir'/`id'.xlsx"') sheet(Table)
  8.     local command_rc = _rc
  9.     noisily display as text "POST251_CASE `id' COMMAND_RC `command_rc'"
 10.     if `command_rc' exit `command_rc'
 11.     return list
 12.     tempname suppression fh
 13.     matrix `suppression' = r(suppression)
 14.     local primary = r(N_primary_suppressed)
 15.     local secondary = r(N_secondary_suppressed)
 16.     local derived = r(N_derived_suppressed)
 17.     matrix list `suppression', format(%20.0g)
 18.     file open `fh' using `"`outdir'/`id'-counts.csv"', write text replace
 19.     file write `fh' "id,command_rc,N_primary_suppressed,N_secondary_suppressed,N_derived_suppressed" _n
 20.     file write `fh' "`id',`command_rc',`primary',`secondary',`derived'" _n
 21.     file close `fh'
 22.     frame _post251_result: quietly save `"`outdir'/`id'-frame.dta"', replace
 23.     frame _post251_result: list, noobs
 24.     frame drop _post251_result
 25. end

