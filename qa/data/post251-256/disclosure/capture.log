. * DS05: Missing count survives; its percentage cannot release a withheld N.
. clear

. gen byte g = .

. gen byte b = .

. local mm "1 4 1 4 0"

. local zz "1 2 0 2 0"

. local oo "3 6 4 8 12"

. local at 0

. forvalues j = 1/5 {
  2.     local m : word `j' of `mm'
  3.     local z : word `j' of `zz'
  4.     local o : word `j' of `oo'
  5.     local n = `m' + `z' + `o'
  6.     quietly set obs `=`at' + `n''
  7.     quietly replace g = `j' in `=`at' + 1'/`=`at' + `n''
  8.     if `z' > 0 quietly replace b = 0 in `=`at' + 1'/`=`at' + `z''
  9.     quietly replace b = 1 in `=`at' + `z' + 1'/`=`at' + `z' + `o''
 10.     local at = `at' + `n'
 11. }

