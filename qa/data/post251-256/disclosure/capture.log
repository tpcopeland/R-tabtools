. * DS03/DS04: tiny denominator strict/primary, shared group Ns and Total.
. clear

. gen byte g = .

. gen byte v = .

. local gn "14 6 6 9"

. local c1 "2 2 1 1"

. local c2 "0 1 0 3"

. local c3 "6 1 1 4"

. local at 0

. forvalues j = 1/4 {
  2.     local n : word `j' of `gn'
  3.     local a : word `j' of `c1'
  4.     local b : word `j' of `c2'
  5.     local c : word `j' of `c3'
  6.     quietly set obs `=`at' + `n''
  7.     quietly replace g = `j' in `=`at' + 1'/`=`at' + `n''
  8.     if `a' > 0 quietly replace v = 1 in `=`at' + 1'/`=`at' + `a''
  9.     if `b' > 0 quietly replace v = 2 in `=`at' + `a' + 1'/`=`at' + `a' + `b''
 10.     if `c' > 0 quietly replace v = 3 in `=`at' + `a' + `b' + 1'/`=`at' + `a' + `b' + `c''
 11.     local at = `at' + `n'
 12. }

. gen double x = _n

