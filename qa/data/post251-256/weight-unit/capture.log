. * ROOT-owned pure native capture, unexecuted by implementer. Cold-load the
. * authenticated 4eecca4d09d61df0cfe773fc2024b015920b5fe6 full closure first.
. * Exactly eight IDs, twelve native commands (four ordinary/huge pairs).
. version 17.0

. set more off

. set varabbrev off

. args artifact_dir

. if `"`artifact_dir'"' == "" exit 198

. 
. program define _post251_weight_capture
  1.     syntax , OUTDIR(string) ID(string) WEIGHT(string) [SMDSPEC(string)]
  2.     quietly save `"`outdir'/`id'-input.dta"', replace
  3.     capture noisily table1_tc, by(g) vars(x contn) wt(`weight') nopvalue ///
>         `smdspec' frame(_post251_weight, replace) ///
>         csv(`"`outdir'/`id'.csv"') markdown(`"`outdir'/`id'.md"') ///
>         excel(`"`outdir'/`id'.xlsx"') sheet(Table)
  4.     local command_rc = _rc
  5.     noisily display as text "POST251_WEIGHT_CASE `id' COMMAND_RC `command_rc'"
  6.     if `command_rc' exit `command_rc'
  7.     return list
  8.     tempname T
  9.     matrix `T' = r(table)
 10.     matrix list `T', format(%24.15g)
 11.     frame _post251_weight: quietly save `"`outdir'/`id'-frame.dta"', replace
 12.     frame _post251_weight: list, noobs
 13.     frame drop _post251_weight
 14. end

. 
. * WX01 pair, WX02 maxpair, WX03 population: hand-declared means/variances.
. forvalues k = 1/3 {
  2.     clear
  3.     local n = cond(`k' == 1, 8, 12)
  4.     quietly set obs `n'
  5.     gen byte g = ceil(_n / 4)
  6.     gen double x = mod(_n-1,4) + 1 + 2*(g-1)
  7.     gen double unit = 1
  8.     gen double huge = 2^1020
  9.     local spec "smd"
 10.     if `k' == 2 local spec "smd smdtype(maxpair)"
 11.     if `k' == 3 local spec "smd smdtype(population)"
 12.     _post251_weight_capture, outdir(`"`artifact_dir'"') id(WX0`k'-unit) weight(unit) smdspec(`spec')
 13.     _post251_weight_capture, outdir(`"`artifact_dir'"') id(WX0`k'-huge) weight(huge) smdspec(`spec')
 14. }
