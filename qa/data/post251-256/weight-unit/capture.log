. 
. * UL01/02/03 default fractional/exponent units; UL04 explicit text.
. forvalues k = 1/4 {
  2.     clear
  3.     quietly set obs 1
  4.     gen byte g = 1
  5.     gen byte e = 1
  6.     gen double y = 10
  7.     local per = cond(`k' == 1, 1e-6, cond(`k' == 2, .5, cond(`k' == 3, 1500.5, 1e-6)))
  8.     local custom ""
  9.     if `k' == 4 local custom "unitlabel(micro-unit)"
 10.     quietly save `"`artifact_dir'/UL0`k'-input.dta"', replace
 11.     capture noisily ratetab g, events(e) exposure(y) per(`per') `custom' ///
>         frame(_post251_rate, replace) ///
>         csv(`"`artifact_dir'/UL0`k'.csv"') markdown(`"`artifact_dir'/UL0`k'.md"') ///
>         xlsx(`"`artifact_dir'/UL0`k'.xlsx"') sheet(Table) ///
>         saving(`"`artifact_dir'/UL0`k'-saved.dta"', replace)
 12.     local command_rc = _rc
 13.     noisily display as text "POST251_UNITLABEL_CASE UL0`k' COMMAND_RC `command_rc'"
 14.     if `command_rc' exit `command_rc'
 15.     return list
 16.     tempname E
 17.     matrix `E' = r(estimates)
 18.     matrix list `E', format(%24.15g)
 19.     frame _post251_rate: quietly save `"`artifact_dir'/UL0`k'-frame.dta"', replace
 20.     frame _post251_rate: list, noobs
 21.     frame drop _post251_rate
 22. }
