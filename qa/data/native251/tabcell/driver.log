. capture program drop golden_ado_version

. program define golden_ado_version, rclass
  1.     * Return the version on the *! header line of an ado file and its path.
.     args adoname
  2.     quietly findfile `adoname'.ado
  3.     local fn "`r(fn)'"
  4.     tempname fh
  5.     file open `fh' using "`fn'", read text
  6.     file read `fh' line
  7.     file close `fh'
  8.     local ver ""
  9.     if regexm(`"`line'"', "[Vv]ersion ([0-9]+\.[0-9]+\.[0-9]+)") local ver = regexs(1)
 10.     return local version "`ver'"
 11.     return local path "`fn'"
 12. end

. 
. capture program drop golden_versions

. program define golden_versions
  1.     * Record the resolved package versions; refuse to run against anything
.     * other than the dev checkouts put first on the adopath by run.do, or
.     * (when expect_version is given) at any other tabtools version. All
.     * checks run before VERSIONS.csv is opened, so a refused run leaves the
.     * committed file untouched.
.     args outfile expect_tabtools expect_fvgen expect_version
  2.     local comps desctab regtab table1_tc _tabtools_common puttab stacktab _tabtools_markdown_write stratetab effecttab comptab hrcomptab fvgen
  3.     foreach a of local comps {
  4.         golden_ado_version `a'
  5.         local v_`a' "`r(version)'"
  6.         local p_`a' "`r(path)'"
  7.         if "`a'" == "fvgen" {
  8.             if strpos("`p_`a''", "`expect_fvgen'") != 1 {
  9.                 display as error "fvgen resolves to `p_`a'', expected under `expect_fvgen'"
 10.                 exit 459
 11.             }
 12.             global GOLDEN_FVGEN_VERSION "`v_`a''"
 13.         }
 14.         else {
 15.             if strpos("`p_`a''", "`expect_tabtools'") != 1 {
 16.                 display as error "`a' resolves to `p_`a'', expected under `expect_tabtools'"
 17.                 exit 459
 18.             }
 19.             if "`expect_version'" != "" & "`v_`a''" != "`expect_version'" {
 20.                 display as error "`a' is version `v_`a'', expected `expect_version' (make_golden.R --tabtools-version=)"
 21.                 exit 459
 22.             }
 23.             if "`a'" == "desctab" global GOLDEN_TABTOOLS_VERSION "`v_`a''"
 24.         }
 25.     }
 26.     tempname fh
 27.     file open `fh' using "`outfile'", write text replace
 28.     file write `fh' "component,version,path" _n
 29.     foreach a of local comps {
 30.         file write `fh' "`a',`v_`a'',`p_`a''" _n
 31.     }
 32.     file write `fh' "stata,`c(stata_version)',`c(edition_real)'" _n
 33.     file write `fh' "rng,`c(rng_current)'," _n
 34.     file write `fh' "linesize,`c(linesize)'," _n
 35.     file close `fh'
 36. end

. 
. capture program drop golden_run

. program define golden_run
  1.     * golden_run <id> <fixture>: expects programs _golden_setup and
.     * _golden_call to be defined for this scenario.
.     args id fixture
  2.     capture log close golden
  3.     clear
  4.     capture collect clear
  5.     estimates clear
  6.     capture macro drop TABTOOLS_*
  7.     capture erase "`id'.csv"
  8.     capture erase "`id'.md"
  9.     capture erase "`id'_stored.csv"
 10.     capture erase "`id'_console.txt"
 11.     capture erase "`id'_input.csv"
 12.     use "fixtures/`fixture'.dta", clear
 13.     capture noisily _golden_setup
 14.     local rc = _rc
 15.     if `rc' == 0 {
 16.         log using "`id'_console.txt", text replace nomsg name(golden)
 17.         capture noisily _golden_call
 18.         local rc = _rc
 19.         if `rc' == 0 mata: golden_dump_r("`id'_stored.csv", "`id'")
 20.         capture log close golden
 21.     }
 22.     tempname fh
 23.     file open `fh' using "_status.csv", write text append
 24.     file write `fh' "`id',`rc'" _n
 25.     file close `fh'
 26.     capture collect clear
 27.     capture stset, clear
 28. end

. 
. capture program drop golden_effect_input

. program define golden_effect_input
  1.     * golden_effect_input <id> <model> <kind> [<subcmd>]: write r(table) of
.     * the last collected teffects/margins command to <id>_input.csv (model 1
.     * starts the file, later models append), one row per column of r(table):
.     * model, kind, subcmd, level, equation, term, estimate, conf_low,
.     * conf_high, p_value at %21.17g. The effecttab goldens' r_call reads it
.     * (golden_effect_input() in helper-golden-effecttab.R), so the R layout
.     * sees Stata's own numbers (IMPLEMENTATION_PLAN.md task 7.11).
.     args id model kind subcmd
  2.     tempname T
  3.     matrix `T' = r(table)
  4.     local lev = r(level)
  5.     if "`lev'" == "" | "`lev'" == "." local lev = c(level)
  6.     mata: golden_effect_rows("`T'", "`id'_input.csv", `model', "`kind'", "`subcmd'", `lev')
  7. end

