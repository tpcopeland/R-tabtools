. program define wp5c_case
  1.     args id out
  2.     log using "`out'/`id'_console.txt", text replace nomsg name(probe)
  3.     local options
  4.     if "`id'" == "OT002" local options `"estimator(logit, or)"'
  5.     if "`id'" == "OT003" local options `"models("z")"'
  6.     if "`id'" == "OT004" local options `"models("z") smallcells(3)"'
  7.     if "`id'" == "OT005" local options "minevents(5)"
  8.     if "`id'" == "OT006" local options "panels(p q) obsprefix(obs_)"
  9.     if "`id'" == "OT008" local options `"sep("long literal separator long literal separator long literal separator long literal separator")"'
 10.     if "`id'" == "OT009" local options `"estimator(poisson, irr vce(cluster id))"'
 11.     outtab event, exposure(exposed) `options' csv("`out'/`id'.csv") ///
>         markdown("`out'/`id'.md") xlsx("`out'/outtab.xlsx") sheet("`id'")
 12.     mata: golden_dump_r("`out'/`id'_stored.csv", "`id'")
 13.     log close probe
 14. end

. foreach id in OT001 OT002 OT003 OT004 OT005 OT006 OT008 OT009 {
