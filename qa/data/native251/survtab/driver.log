. capture program drop wp6c_case

. program define wp6c_case
  1.     args id out times options
  2.     save "`out'/`id'_input.dta"
  3.     log using "`out'/`id'_console.txt", text nomsg name(svcase)
  4.     survtab, times(`times') `options' footnote("Native annotation.") xlsx("`out'/survtab.xlsx") sheet("`id'") ///
>         csv("`out'/`id'.csv") markdown("`out'/`id'.md")
  5.     mata: golden_dump_r("`out'/`id'_stored.csv", "`id'")
  6.     log close svcase
  7. end

